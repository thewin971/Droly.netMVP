# Liste des variables à créer dans Vercel → Settings → Environment Variables.
# Ne mets JAMAIS tes vraies valeurs dans ce fichier ni sur GitHub : uniquement dans Vercel.
# Détail de chaque valeur : SETUP.md, étape 4.

# Supabase (Project Settings → API Keys, et bouton Connect pour l'adresse)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Stripe (API keys, Product catalog, Webhooks)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Dreamina Seedance (BytePlus ModelArk → API Key Management)
SEEDANCE_API_KEY=...

# Facultatif
# Modèles vidéo (le pack de crédits BytePlus doit être celui du modèle utilisé) :
# SEEDANCE_MODEL=seedance-1-0-pro-fast-251015          vidéos "Travelling" (5 s)
# SEEDANCE_TOUR_MODEL=dreamina-seedance-2-0-mini-260615 tours à 360° (10 s)
# MAX_VIDEOS_PER_MONTH=30
# MAX_VIDEOS_PER_DAY=10
# MAX_TOURS_PER_MONTH=5
# FREE_TRIALS_PER_DAY=20     vidéos gratuites offertes chaque jour sur la page d'accueil (0 = essai fermé)
# SITE_URL=https://ton-domaine.fr
